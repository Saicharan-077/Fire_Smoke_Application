# Top-level env file for docker-compose's OWN variable substitution.
#
# This is a DIFFERENT mechanism from backend/.env.example: Docker Compose
# auto-loads a file literally named `.env` in the SAME DIRECTORY as
# docker-compose.yml (this directory) to resolve ${VAR} references inside the
# compose file itself -- independent of whether the application code inside
# the container ever calls load_dotenv() (it doesn't; see backend/.env.example
# for that side).
#
# Copy this to `.env` in this same directory and fill in real values before
# running `docker compose up`. PIPELINE_API_KEY and DASHBOARD_MEDIA_TOKEN_SECRET
# have no default in docker-compose.yml -- compose will refuse to start
# without them, on purpose, rather than silently booting with the pipeline
# proxy unauthenticated.

# Must match the detection pipeline's own PIPELINE_API_KEY
# (sentinel-pipeline/.env). Generate with:
#   python3 -c "import secrets; print('sk-sentinel-' + secrets.token_urlsafe(32))"
PIPELINE_API_KEY=

# Signs the short-lived tokens used for evidence images and the MJPEG stream.
# Independent of PIPELINE_API_KEY -- this one never leaves the dashboard
# backend at all, not even to the pipeline. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_MEDIA_TOKEN_SECRET=

# Where the detection pipeline actually runs. NOT containerized in this
# compose file yet -- see NEWREADME.md TODO. localhost only works if the
# pipeline runs on the same host as this container with compatible
# networking; a real multi-host deployment needs a real reachable address.
PIPELINE_BASE_URL=http://localhost:8100
