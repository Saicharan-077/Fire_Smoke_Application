# ──────────────────────────────────────────────────────────────────────────────
# FireGuard AI — Environment Configuration
# Copy this file as .env and fill in the appropriate values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
# Secret key used for JWT token signing (change in production!)
SECRET_KEY=fireguard-super-secret-key-change-me

# Database URL (SQLite by default; use PostgreSQL in production)
DATABASE_URL=sqlite:///./fireguard.db

# YOLO model weights path (relative to backend root)
YOLO_MODEL_PATH=models/best.pt

# Server host and port
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time alerts
VITE_WS_URL=ws://localhost:8000/ws/alerts

# Evidence file base URL (usually same as API base)
VITE_EVIDENCE_BASE_URL=http://localhost:8000
