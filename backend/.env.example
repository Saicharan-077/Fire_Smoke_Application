# SentinelOS Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ───────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (default, good for development).
# Set a PostgreSQL connection string for production.
POSTGRES_URL=

# ── Admin Credentials ─────────────────────────────────────────────────────────
# Set a password for the initial admin account (admin@sentinelos.ai).
# If left empty, a secure random password is auto-generated on first run
# and printed ONCE to the server log — check logs and change it immediately.
ADMIN_INITIAL_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Application ───────────────────────────────────────────────────────────────
ENV=development
HOST=0.0.0.0
PORT=8000

# ── Seeding ───────────────────────────────────────────────────────────────────
# Seed demo cameras and alerts on first startup.
SEED_DATABASE=true
# Set to true to reset admin password to ADMIN_INITIAL_PASSWORD on next startup.
SEED_RESET_PASSWORDS=false

# ── Session ───────────────────────────────────────────────────────────────────
# Session token lifetime in minutes (default: 24 hours)
SESSION_DURATION_MINUTES=1440
# Allow unauthenticated users to self-register (creates viewer accounts)
ALLOW_PUBLIC_REGISTRATION=true

# ── Model ─────────────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=models/best.pt
