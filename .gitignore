# Virtualenvs and toolchains
.venv-pipeline/
.venv-dashboard/
.node-bin/
**/node_modules/
__pycache__/
*.py[cod]

# Model weights and archives (large binaries, tracked out-of-band)
*.zip
*.pt
!sentinel-pipeline/tests/fixtures/**

# Runtime state
sentinel-pipeline/data/
**/evidence/*.jpg
**/facility_maps/*
!**/facility_maps/.gitkeep
**/*.db
**/*.db-wal
**/*.db-shm
*.log

# Build output
**/dist/
**/.vite/

# Secrets
.env
.env.local
